# SnapTrace environment template - copy to .env and fill in real values.
# .env is gitignored; this file is safe to commit.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/snaptrace

# --- Background queue ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT signing secret - generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AWS S3 (optional: leave empty to store photos on local disk) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Limits ---
MAX_UPLOAD_MB=10
MAX_FILES_PER_UPLOAD=50
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=100
SEARCH_DEFAULT_TOP_K=50
SEARCH_MAX_TOP_K=200
SEARCH_DEFAULT_THRESHOLD=0.45
